<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="12dp"
    android:background="@drawable/bg_forest_card_gradient"
    android:elevation="3dp">

    <!-- Non-Interactive Decorative Micro-Vector Accents Overlay Layer -->
    <!-- Enforces non-interactive accessibility and input blocking prevention -->
    <ImageView
        android:id="@+id/ivDecorativeCardAccents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.12"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/ic_decorative_card_accents" />

    <!-- Interactive Foreground Layer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Row: Balance Label & Visibility Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Saldo"
                android:textColor="#D8FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnToggleBalance"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sembunyikan Saldo"
                android:src="@android:drawable/ic_menu_view"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Balance Amount -->
        <TextView
            android:id="@+id/tvTotalBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="Rp 13.750.000"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Quick Actions Row (Strictly Income vs Expense & Link Bank - No Transfer) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickLinkBank"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#29FFFFFF"
                android:text="+ Bank"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickAddIncome"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1.2"
                android:backgroundTint="#29FFFFFF"
                android:text="+ Pemasukan"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickAddExpense"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.25"
                android:backgroundTint="#29FFFFFF"
                android:text="- Pengeluaran"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

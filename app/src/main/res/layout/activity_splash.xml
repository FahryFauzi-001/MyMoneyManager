<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F6">

    <!-- Centerpiece Brand Content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Logo Container with Soft Circular Tint Background -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp">

            <!-- Custom MyMoneyManager Logo: Minimalist leather-fold wallet with dual-tone currency flow accents -->
            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_mymoneymanager_logo" />
        </FrameLayout>

        <!-- App Title in Clean Typography -->
        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="#191D19"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Subtext / Tagline -->
        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:text="@string/tagline_manage_finance"
            android:textColor="#2D5A27"
            android:textSize="15sp" />

        <!-- Subtle Indefinite Circular Progress Indicator -->
        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="48dp"
            android:indeterminate="true"
            android:indeterminateTint="#2D5A27" />

    </LinearLayout>

</FrameLayout>

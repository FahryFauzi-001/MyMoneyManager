<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Refined Transaction Type Toggle (Strictly Income vs Expense) -->
        <RadioGroup
            android:id="@+id/rgTransactionType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#E2EADF"
            android:checkedButton="@+id/rbExpense"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbExpense"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="@string/title_expense"
                android:textColor="#1E5E3A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbIncome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="@string/title_income"
                android:textColor="#1E5E3A"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- Amount Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nominal"
            android:textColor="#191D19"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvCurrencyPrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp "
                android:textColor="#1E5E3A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="0"
                android:inputType="number"
                android:textColor="#191D19"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Source Account Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Rekening Sumber"
            android:textColor="#191D19"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spSourceAccount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:paddingHorizontal="12dp" />

        <!-- Category Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kategori"
            android:textColor="#191D19"
            android:textSize="14sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/llCategoryChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="#1E5E3A"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="🍜 Makanan"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="#E2EADF"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="🚕 Transportasi"
                    android:textColor="#191D19"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="#E2EADF"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="🛍️ Belanja"
                    android:textColor="#191D19"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Date Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tanggal Transaksi"
            android:textColor="#191D19"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPickDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FFFFFF"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            android:text="22 Nov 2026"
            android:textColor="#191D19"
            android:textSize="14sp" />

        <!-- Note Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Catatan"
            android:textColor="#191D19"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:hint="Contoh: Makan siang, bayar listrik (opsional)"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="#191D19"
            android:textSize="14sp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveTransaction"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#1E5E3A"
            android:text="Simpan Transaksi"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
